<div class="min-h-screen bg-white flex items-center justify-center px-4 py-12">
    <div class="max-w-2xl w-full">
        <div class="text-center mb-12">
            {{#if eventSettings.logo_filename}}
            <img src="/uploads/{{eventSettings.logo_filename}}" alt="{{eventSettings.event_name}}" class="max-h-20 mx-auto mb-6">
            {{/if}}
            <p class="text-sm text-gray-500 mb-2">Team registration</p>
            {{#if progress}}
            <p class="text-xs uppercase tracking-wide text-gray-400">Step {{progress.current}} of {{progress.total}} · {{progress.label}}</p>
            {{/if}}
        </div>

        <div class="border border-gray-200 rounded-lg p-8">
            {{#if error}}
            <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded">
                <p class="text-sm text-red-800 font-medium">{{error}}</p>
            </div>
            {{/if}}

            {{#if (eq step "done")}}
            {{#if isParent}}
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">You finished this team as the parent</h1>
            <p class="text-sm text-gray-600 mb-6">This account is the team contact for the participant under 18.</p>
            {{/if}}
            <div class="bg-green-50 border-l-4 border-green-400 p-4 rounded">
                <p class="text-sm text-green-800 font-medium">{{success}}</p>
            </div>
            <a href="{{dashboardUrl}}" class="mt-6 inline-flex w-full justify-center px-6 py-4 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-semibold transition">
                Go to your dashboard
            </a>
            {{/if}}

            {{#if (eq step "event")}}
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Which event?</h1>
            <p class="text-sm text-gray-600 mb-6">Choose the event this team is registering for.</p>
            {{#if events.length}}
            <form method="POST" action="/register/event" class="space-y-3">
                {{#each events}}
                <label class="flex items-start gap-3 border border-gray-200 rounded-lg p-4 cursor-pointer hover:border-gray-400">
                    <input type="radio" name="eventId" value="{{this.id}}" class="mt-1" {{#if (eq this.id ../selectedEventId)}}checked{{/if}} required>
                    <span>
                        <span class="block text-sm font-semibold text-gray-900">{{this.event_name}}</span>
                        <span class="block text-xs text-gray-500 mt-1">
                            {{#if this.event_dates_text}}{{this.event_dates_text}}{{else if this.start_date}}{{this.start_date}}{{#if this.end_date}} — {{this.end_date}}{{/if}}{{else}}Dates to be announced{{/if}}
                        </span>
                    </span>
                </label>
                {{/each}}
                {{#if isSchool}}
                <p class="text-xs text-gray-500">You'll add the project next. Student names, emails, and ages are not collected.</p>
                {{/if}}
                <button type="submit" class="w-full px-6 py-4 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-semibold transition">Continue</button>
            </form>
            {{else}}
            <p class="text-sm text-gray-600">No events are open for registration.</p>
            {{/if}}
            {{/if}}

            {{#if (eq step "school")}}
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Are you part of a school?</h1>
            <p class="text-sm text-gray-600 mb-6">{{#if eventName}}Registering for {{eventName}}.{{/if}} School teams are registered by a chaperone.</p>
            <form method="POST" action="/register/school" class="space-y-3">
                <button type="submit" name="belongsToSchool" value="no" class="w-full px-6 py-4 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-semibold transition">No, I'm registering on my own</button>
                <button type="submit" name="belongsToSchool" value="yes" class="w-full px-6 py-4 bg-white hover:bg-gray-50 text-gray-900 border border-gray-300 rounded-lg font-semibold transition">Yes, I'm part of a school</button>
            </form>
            {{/if}}

            {{#if (eq step "chaperone")}}
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Ask your chaperone</h1>
            <p class="text-sm text-gray-700 mb-4">School teams are registered by a chaperone using the school account. Student names, emails, and ages are not collected here.</p>
            <p class="text-sm text-gray-700 mb-6">If you are the chaperone, sign in with the school account and add the team.</p>
            <a href="/auth/login" class="inline-flex w-full justify-center px-6 py-4 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-semibold transition">School sign in</a>
            <form method="POST" action="/register/school" class="mt-3">
                <button type="submit" name="belongsToSchool" value="no" class="w-full px-6 py-4 bg-white hover:bg-gray-50 text-gray-900 border border-gray-300 rounded-lg font-semibold transition">I'm registering on my own</button>
            </form>
            {{/if}}

            {{#if (eq step "age")}}
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Are you under 18?</h1>
            <p class="text-sm text-gray-600 mb-6">Participants under 18 need a parent to finish signup.</p>
            <form method="POST" action="/register/age" class="space-y-3">
                <button type="submit" name="isUnder18" value="no" class="w-full px-6 py-4 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-semibold transition">No, I'm 18 or older</button>
                <button type="submit" name="isUnder18" value="yes" class="w-full px-6 py-4 bg-white hover:bg-gray-50 text-gray-900 border border-gray-300 rounded-lg font-semibold transition">Yes, I'm under 18</button>
            </form>
            {{/if}}

            {{#if (eq step "parent")}}
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Email a parent</h1>
            <p class="text-sm text-gray-600 mb-6">We'll send them a link to add the team and project. The team is not registered until they finish.</p>
            <form method="POST" action="/register/parent" class="space-y-6">
                <div>
                    <label for="guardianEmail" class="block text-sm font-semibold text-gray-700 mb-2">Parent email <span class="text-red-500">*</span></label>
                    <input type="email" id="guardianEmail" name="guardianEmail" required value="{{guardianEmail}}" placeholder="parent@example.com" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition">
                </div>
                <button type="submit" class="w-full px-6 py-4 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-semibold transition">Email my parent</button>
            </form>
            {{/if}}

            {{#if (eq step "parent-sent")}}
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">You're done for now</h1>
            <div class="bg-green-50 border-l-4 border-green-400 p-4 rounded">
                <p class="text-sm text-green-800 font-medium">We emailed {{guardianEmail}}. They need to open that link and finish the team. You can close this page. Nothing is registered until they do.</p>
            </div>
            {{/if}}

            {{#if (eq step "members")}}
            {{#if isParentInvite}}
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Finish the team as the parent</h1>
            <p class="text-sm text-gray-600 mb-6">A participant under 18 asked you to register this team. Add a name and email for each person, then the project.{{#if eventName}} Registering for {{eventName}}.{{/if}}</p>
            {{else}}
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Team member contacts</h1>
            <p class="text-sm text-gray-600 mb-6">Add a name and email for each person on the team.{{#if eventName}} Registering for {{eventName}}.{{/if}}</p>
            {{/if}}
            <form method="POST" action="/register/members" class="space-y-6">
                <div id="memberRows" class="space-y-3">
                    {{#each members}}
                    <div class="member-row grid grid-cols-1 sm:grid-cols-[1fr_1fr_auto] gap-2">
                        <input type="text" name="memberName" value="{{memberName this}}" placeholder="Name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition">
                        <input type="email" name="memberEmail" value="{{memberEmail this}}" placeholder="Email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition">
                        <button type="button" onclick="removeMember(this)" class="px-4 py-3 bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 rounded-lg font-medium">Remove</button>
                    </div>
                    {{/each}}
                </div>
                <button type="button" onclick="addMember()" class="px-4 py-2 bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 rounded-lg font-medium">Add member</button>
                <button type="submit" class="w-full px-6 py-4 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-semibold transition">Continue</button>
            </form>
            {{/if}}

            {{#if (eq step "project")}}
            {{#if isParentInvite}}
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Finish the project as the parent</h1>
            <p class="text-sm text-gray-600 mb-6">You're the parent completing signup for a participant under 18.{{#if eventName}} {{eventName}}.{{/if}}</p>
            {{else}}
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Project info</h1>
            <p class="text-sm text-gray-600 mb-6">{{#if eventName}}{{eventName}}. {{/if}}{{#if isSchool}}This team is registered with your chaperone email. Student names, emails, and ages are not collected.{{else}}Tell us about the project.{{/if}}</p>
            {{/if}}
            <form method="POST" action="/register/project" class="space-y-6">
                <div>
                    <label for="teamName" class="block text-sm font-semibold text-gray-700 mb-2">Team Name <span class="text-red-500">*</span></label>
                    <input type="text" id="teamName" name="teamName" required value="{{form.teamName}}" placeholder="e.g., Team Awesome" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="tableSearch" class="block text-sm font-semibold text-gray-700 mb-2">Table Location <span class="text-red-500">*</span></label>
                        <div class="relative">
                            <input type="text" id="tableSearch" value="{{form.tableName}}" placeholder="Type to search tables..." class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition" onkeyup="filterTables()" onfocus="showTableDropdown()" autocomplete="off">
                            <input type="hidden" id="tableName" name="tableName" value="{{form.tableName}}" required>
                            <div id="tableDropdown" class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto">
                                {{#each tables}}
                                <div class="table-option px-4 py-2 cursor-pointer hover:bg-gray-50" data-table="{{this}}" onclick="selectTable('{{this}}')">{{this}}</div>
                                {{/each}}
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 mt-2">Chess board style (A1-P10)</p>
                    </div>
                    <div>
                        <label for="categoryId" class="block text-sm font-semibold text-gray-700 mb-2">Category <span class="text-red-500">*</span></label>
                        <select id="categoryId" name="categoryId" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition">
                            <option value="" disabled {{#unless form.categoryId}}selected{{/unless}}>Select Category</option>
                            {{#each categories}}
                            <option value="{{this.id}}" {{#if (eq this.id ../form.categoryId)}}selected{{/if}}>{{this.name}}</option>
                            {{/each}}
                        </select>
                        {{#unless categories.length}}
                        <p class="text-xs text-red-500 mt-2">Categories must be added by administrators before registration</p>
                        {{/unless}}
                    </div>
                </div>

                {{#if divisions.length}}
                <div>
                    <label for="division" class="block text-sm font-semibold text-gray-700 mb-2">Division <span class="text-red-500">*</span></label>
                    <select id="division" name="division" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition">
                        <option value="" disabled {{#unless form.division}}selected{{/unless}}>Select Division</option>
                        {{#each divisions}}
                        <option value="{{this}}" {{#if (eq this ../form.division)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
                {{/if}}

                <div>
                    <label for="projectName" class="block text-sm font-semibold text-gray-700 mb-2">Project Name <span class="text-red-500">*</span></label>
                    <input type="text" id="projectName" name="projectName" required value="{{form.projectName}}" placeholder="e.g., AI-Powered Solution" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition">
                </div>

                {{#if isSchool}}
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Chaperone email</label>
                    <input type="email" value="{{user.email}}" readonly class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-600">
                </div>
                {{/if}}

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="websiteLink" class="block text-sm font-semibold text-gray-700 mb-2">Website / Demo Link</label>
                        <input type="url" id="websiteLink" name="websiteLink" value="{{form.websiteLink}}" placeholder="https://your-project.com" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition">
                    </div>
                    <div>
                        <label for="githubLink" class="block text-sm font-semibold text-gray-700 mb-2">GitHub Repository</label>
                        <input type="url" id="githubLink" name="githubLink" value="{{form.githubLink}}" placeholder="https://github.com/..." class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition">
                    </div>
                </div>

                <div class="border-t border-gray-200 pt-6 space-y-3">
                    <h2 class="text-sm font-semibold text-gray-900">Required Agreements</h2>
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="checkbox" name="privacyPolicyAccepted" value="1" required {{#if form.privacyPolicyAccepted}}checked{{/if}} class="mt-1 w-4 h-4 text-gray-900 border-gray-300 rounded">
                        <span class="text-sm font-semibold text-gray-700">I accept the <a href="/policies/privacy" target="_blank" class="underline">Privacy Policy</a> <span class="text-red-500">*</span></span>
                    </label>
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="checkbox" name="termsAccepted" value="1" required {{#if form.termsAccepted}}checked{{/if}} class="mt-1 w-4 h-4 text-gray-900 border-gray-300 rounded">
                        <span class="text-sm font-semibold text-gray-700">I accept the <a href="/policies/terms" target="_blank" class="underline">Terms of Use</a> <span class="text-red-500">*</span></span>
                    </label>
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="checkbox" name="acceptableUseAccepted" value="1" required {{#if form.acceptableUseAccepted}}checked{{/if}} class="mt-1 w-4 h-4 text-gray-900 border-gray-300 rounded">
                        <span class="text-sm font-semibold text-gray-700">I accept the <a href="/policies/acceptable-use" target="_blank" class="underline">Acceptable Use Policy</a> <span class="text-red-500">*</span></span>
                    </label>
                </div>

                <label class="flex items-start gap-3 cursor-pointer border-t border-gray-200 pt-6">
                    <input type="checkbox" name="emailPreferences" value="1" {{#if form.emailPreferences}}checked{{/if}} class="mt-1 w-4 h-4 text-gray-900 border-gray-300 rounded">
                    <span>
                        <span class="block text-sm font-semibold text-gray-700">Email Preferences</span>
                        <span class="block text-xs text-gray-500 mt-1">I would like to receive emails about future code-camp events and other code-related content</span>
                    </span>
                </label>

                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <p class="text-xs text-gray-700"><strong>Data Privacy:</strong> We do not sell your personal data or share it with third parties. Your information is used solely for event management and communication. See our <a href="/policies/privacy" target="_blank" class="underline">Privacy Policy</a>.</p>
                </div>

                <button type="submit" class="w-full px-6 py-4 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-semibold transition">Register Team</button>
            </form>
            {{/if}}

            {{#if canGoBack}}
            <form method="POST" action="/register/back" class="mt-4">
                <button type="submit" class="w-full px-6 py-3 text-sm font-semibold text-gray-700 hover:text-gray-900">Back</button>
            </form>
            {{/if}}
        </div>
    </div>
</div>

<script>
    function selectTable(tableName) {
        const search = document.getElementById('tableSearch');
        const hidden = document.getElementById('tableName');
        const dropdown = document.getElementById('tableDropdown');
        if (!search || !hidden || !dropdown) return;
        search.value = tableName;
        hidden.value = tableName;
        dropdown.classList.add('hidden');
    }

    function showTableDropdown() {
        const dropdown = document.getElementById('tableDropdown');
        if (dropdown) dropdown.classList.remove('hidden');
    }

    function filterTables() {
        const input = document.getElementById('tableSearch');
        const dropdown = document.getElementById('tableDropdown');
        if (!input || !dropdown) return;
        const filter = input.value.toUpperCase();
        const options = dropdown.getElementsByClassName('table-option');
        let hasVisibleOptions = false;
        for (let i = 0; i < options.length; i++) {
            const txtValue = options[i].textContent || options[i].innerText;
            const visible = txtValue.toUpperCase().indexOf(filter) > -1;
            options[i].style.display = visible ? '' : 'none';
            if (visible) hasVisibleOptions = true;
        }
        dropdown.classList.toggle('hidden', !hasVisibleOptions);
        const hidden = document.getElementById('tableName');
        if (hidden) hidden.value = input.value.trim();
    }

    document.addEventListener('click', function (event) {
        const dropdown = document.getElementById('tableDropdown');
        const searchInput = document.getElementById('tableSearch');
        if (!dropdown || !searchInput) return;
        if (!dropdown.contains(event.target) && event.target !== searchInput) {
            dropdown.classList.add('hidden');
        }
    });

    function addMember() {
        const container = document.getElementById('memberRows');
        if (!container) return;
        const row = document.createElement('div');
        row.className = 'member-row grid grid-cols-1 sm:grid-cols-[1fr_1fr_auto] gap-2';
        row.innerHTML = `
            <input type="text" name="memberName" placeholder="Name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition">
            <input type="email" name="memberEmail" placeholder="Email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition">
            <button type="button" class="px-4 py-3 bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 rounded-lg font-medium">Remove</button>
        `;
        row.querySelector('button').addEventListener('click', function () {
            removeMember(this);
        });
        container.appendChild(row);
    }

    function removeMember(button) {
        const container = document.getElementById('memberRows');
        if (!container || container.children.length <= 1) return;
        button.parentElement.remove();
    }
</script>
