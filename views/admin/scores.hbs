<div class="min-h-screen bg-white">
    <div class="bg-white border-b border-gray-200">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight">Scores</h1>
                    <p class="text-sm text-gray-500 mt-2">Edit any judge's score, or set the order when totals tie.</p>
                </div>
                <a href="/admin" class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition">
                    ← Back to Admin
                </a>
            </div>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {{#if (eq (lookup query 'success') 'score_updated')}}
        <div class="mb-6 bg-green-50 border border-green-200 rounded-lg p-4">
            <p class="text-green-800 font-medium">Score updated.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'success') 'score_deleted')}}
        <div class="mb-6 bg-green-50 border border-green-200 rounded-lg p-4">
            <p class="text-green-800 font-medium">Score deleted. That judge's slot for the team and round is open again.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'success') 'absence_deleted')}}
        <div class="mb-6 bg-green-50 border border-green-200 rounded-lg p-4">
            <p class="text-green-800 font-medium">Absence removed. That judge's slot is open again when they had not scored the team.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'success') 'tie_break')}}
        <div class="mb-6 bg-green-50 border border-green-200 rounded-lg p-4">
            <p class="text-green-800 font-medium">Tie-break order saved. Scores were not changed.</p>
        </div>
        {{/if}}
        {{#if (lookup query 'error')}}
        <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
            <p class="text-red-800">That change could not be saved. Check the score and try again.</p>
        </div>
        {{/if}}

        <form method="GET" action="/admin/scores" class="mb-10 grid grid-cols-1 sm:grid-cols-4 gap-4 items-end">
            <div>
                <label for="round" class="block text-sm font-medium text-gray-700 mb-2">Round</label>
                <select id="round" name="round"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent">
                    <option value="">All rounds</option>
                    {{#each roundOptions}}
                    <option value="{{this}}" {{#if (eq this ../selectedRound)}}selected{{/if}}>Round {{this}}</option>
                    {{/each}}
                </select>
            </div>
            <div>
                <label for="team" class="block text-sm font-medium text-gray-700 mb-2">Team</label>
                <input id="team" name="team" value="{{teamFilter}}"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent">
            </div>
            <div>
                <label for="judge" class="block text-sm font-medium text-gray-700 mb-2">Judge</label>
                <input id="judge" name="judge" value="{{judgeFilter}}"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent">
            </div>
            <button type="submit"
                class="px-4 py-2 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-semibold transition">
                Filter
            </button>
        </form>

        <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-2">Individual scores</h2>
            <p class="text-sm text-gray-600 mb-4">Edits here are allowed after a round or all judging is locked. Deleting a score removes that judge's assignment so another judge can fill the slot. Each team still caps at {{requiredJudgesPerTeam}} judges per round.</p>
            {{#if scores.length}}
            <div class="border border-gray-200 rounded-lg overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Round</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Team</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Table</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Judge</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">Score</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Notes</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {{#each scores}}
                            <tr>
                                <td class="px-4 py-3 text-sm text-gray-900">{{this.round}}</td>
                                <td class="px-4 py-3 text-sm font-medium text-gray-900">{{this.team_name}}</td>
                                <td class="px-4 py-3 text-sm text-gray-600">{{this.table_name}}</td>
                                <td class="px-4 py-3 text-sm text-gray-600">{{this.judge_email}}</td>
                                <td class="px-4 py-3 text-sm font-semibold text-gray-900 text-right">{{this.score}}</td>
                                <td class="px-4 py-3 text-sm text-gray-600 max-w-xs truncate">{{this.notes}}</td>
                                <td class="px-4 py-3 text-sm text-right whitespace-nowrap">
                                    <a href="/admin/scores/{{this.id}}/edit"
                                        class="text-gray-900 font-medium hover:underline">Edit</a>
                                    <form method="POST" action="/admin/scores/{{this.id}}/delete" class="inline"
                                        onsubmit="return confirm('Delete this score? The judge slot for this team and round will open up.');">
                                        <button type="submit" class="ml-3 text-red-700 font-medium hover:underline">Delete</button>
                                    </form>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
            {{else}}
            <p class="text-gray-500">No scores match these filters.</p>
            {{/if}}
        </div>

        <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-2">Absences</h2>
            <p class="text-sm text-gray-600 mb-4">A judge marks a team absent when they cannot find them. Removing an absence reopens that judge's slot unless they also submitted a score.</p>
            {{#if absences.length}}
            <div class="border border-gray-200 rounded-lg overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Round</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Team</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Table</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Judge</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {{#each absences}}
                            <tr>
                                <td class="px-4 py-3 text-sm text-gray-900">{{this.round}}</td>
                                <td class="px-4 py-3 text-sm font-medium text-gray-900">{{this.team_name}}</td>
                                <td class="px-4 py-3 text-sm text-gray-600">{{this.table_name}}</td>
                                <td class="px-4 py-3 text-sm text-gray-600">{{this.judge_email}}</td>
                                <td class="px-4 py-3 text-sm text-right">
                                    <form method="POST" action="/admin/absences/{{this.id}}/delete" class="inline"
                                        onsubmit="return confirm('Remove this absence? The judge slot opens again if this judge did not score the team.');">
                                        <button type="submit" class="text-red-700 font-medium hover:underline">Remove</button>
                                    </form>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
            {{else}}
            <p class="text-gray-500">No absences match these filters.</p>
            {{/if}}
        </div>

        <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-2">Standings through round {{standingsRound}}</h2>
            <p class="text-sm text-gray-600 mb-6">Totals are the sum of every score through this round. When two teams share a total, move them up or down. The numbers stay the same, and the leaderboard uses this order.</p>
            {{#if (eq (size standings) 0)}}
            <p class="text-gray-500">No standings yet.</p>
            {{else}}
            {{#each standings}}
            <div class="mb-8">
                <h3 class="text-lg font-semibold text-gray-900 mb-3">{{@key}}</h3>
                <div class="border border-gray-200 rounded-lg overflow-hidden">
                    <table class="w-full">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Place</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Team</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Table</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">Total</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">Order</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {{#each this}}
                            <tr>
                                <td class="px-4 py-3 text-sm text-gray-900">{{this.rank}}</td>
                                <td class="px-4 py-3 text-sm font-medium text-gray-900">
                                    {{this.team_name}}
                                    {{#if this.scoreTied}}
                                    {{#unless this.tieResolved}}
                                    <span class="ml-2 text-xs font-medium text-amber-700">Tied</span>
                                    {{/unless}}
                                    {{/if}}
                                </td>
                                <td class="px-4 py-3 text-sm text-gray-600">{{this.table_name}}</td>
                                <td class="px-4 py-3 text-sm font-semibold text-gray-900 text-right">{{toFixed this.total_score 1}}</td>
                                <td class="px-4 py-3 text-right">
                                    {{#if this.scoreTied}}
                                    <form method="POST" action="/admin/scores/tie-break" class="inline">
                                        <input type="hidden" name="division" value="{{this.division_key}}">
                                        <input type="hidden" name="round" value="{{@root.standingsRound}}">
                                        <input type="hidden" name="teamName" value="{{this.team_name}}">
                                        <input type="hidden" name="team" value="{{@root.teamFilter}}">
                                        <input type="hidden" name="judge" value="{{@root.judgeFilter}}">
                                        <input type="hidden" name="direction" value="up">
                                        <button type="submit" {{#if this.tieGroupFirst}}disabled{{/if}}
                                            class="px-2 py-1 text-sm border border-gray-300 rounded disabled:opacity-40">Up</button>
                                    </form>
                                    <form method="POST" action="/admin/scores/tie-break" class="inline">
                                        <input type="hidden" name="division" value="{{this.division_key}}">
                                        <input type="hidden" name="round" value="{{@root.standingsRound}}">
                                        <input type="hidden" name="teamName" value="{{this.team_name}}">
                                        <input type="hidden" name="team" value="{{@root.teamFilter}}">
                                        <input type="hidden" name="judge" value="{{@root.judgeFilter}}">
                                        <input type="hidden" name="direction" value="down">
                                        <button type="submit" {{#if this.tieGroupLast}}disabled{{/if}}
                                            class="px-2 py-1 text-sm border border-gray-300 rounded disabled:opacity-40">Down</button>
                                    </form>
                                    {{else}}
                                    <span class="text-sm text-gray-400">—</span>
                                    {{/if}}
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
            {{/each}}
            {{/if}}
        </div>
    </div>
</div>
