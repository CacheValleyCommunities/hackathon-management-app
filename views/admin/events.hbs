<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-4xl font-bold text-gray-900 tracking-tight">Events</h1>
            <p class="text-gray-600 mt-2">Each event has its own teams, judges, tables, and scores.</p>
        </div>
        <a href="/admin" class="text-sm text-gray-600 hover:text-gray-900">Back to dashboard</a>
    </div>

    {{#if error}}
    <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4 text-red-800">{{error}}</div>
    {{/if}}

    <form method="POST" action="/admin/events" class="border border-gray-200 rounded-lg p-5 mb-8 grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end">
        <div>
            <label for="eventName" class="block text-sm font-semibold text-gray-700 mb-2">New event name</label>
            <input id="eventName" name="eventName" required class="w-full px-4 py-3 border border-gray-300 rounded-lg" placeholder="Spring Code Camp">
        </div>
        <button type="submit" class="px-4 py-3 text-sm font-semibold text-white bg-gray-900 rounded-lg hover:bg-gray-800">Create draft</button>
    </form>

    <div class="space-y-4">
        {{#each events}}
        <div class="border border-gray-200 rounded-lg p-5">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div class="min-w-0 flex-1">
                    <h2 class="text-xl font-semibold text-gray-900">{{this.event_name}}</h2>
                    <p class="text-sm text-gray-500 mt-1">/events/{{this.slug}} · {{this.status}}{{#if (eq ../currentEventId this.id)}} · current{{/if}}</p>
                    <form method="POST" action="/admin/events/{{this.id}}/rename" class="mt-4 flex flex-col sm:flex-row gap-2 sm:items-center">
                        <label for="eventName-{{this.id}}" class="sr-only">Event name</label>
                        <input id="eventName-{{this.id}}" name="eventName" value="{{this.event_name}}" required class="w-full sm:max-w-sm px-3 py-2 border border-gray-300 rounded-lg">
                        <button type="submit" class="px-3 py-2 text-sm font-semibold border border-gray-300 rounded-lg hover:bg-gray-50">Rename</button>
                    </form>
                </div>
                <div class="flex flex-wrap gap-2">
                    <form method="POST" action="/events/select">
                        <input type="hidden" name="eventId" value="{{this.id}}">
                        <button type="submit" class="px-3 py-2 text-sm font-semibold text-white bg-gray-900 rounded-lg">Switch to this event</button>
                    </form>
                    {{#unless (eq this.status 'open')}}
                    <form method="POST" action="/admin/events/{{this.id}}/status">
                        <input type="hidden" name="status" value="open">
                        <button type="submit" class="px-3 py-2 text-sm border border-gray-300 rounded-lg">Open</button>
                    </form>
                    {{/unless}}
                    {{#unless (eq this.status 'closed')}}
                    <form method="POST" action="/admin/events/{{this.id}}/status">
                        <input type="hidden" name="status" value="closed">
                        <button type="submit" class="px-3 py-2 text-sm border border-gray-300 rounded-lg">Close</button>
                    </form>
                    {{/unless}}
                    {{#unless (eq this.status 'archived')}}
                    <form method="POST" action="/admin/events/{{this.id}}/status">
                        <input type="hidden" name="status" value="archived">
                        <button type="submit" class="px-3 py-2 text-sm border border-gray-300 rounded-lg">Archive</button>
                    </form>
                    {{/unless}}
                    {{#unless (eq this.status 'draft')}}
                    <form method="POST" action="/admin/events/{{this.id}}/status">
                        <input type="hidden" name="status" value="draft">
                        <button type="submit" class="px-3 py-2 text-sm border border-gray-300 rounded-lg">Draft</button>
                    </form>
                    {{/unless}}
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>
