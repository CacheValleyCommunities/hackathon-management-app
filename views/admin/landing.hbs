<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Landing Page Settings</h1>
            <p class="text-gray-600">Customize the public landing page for your event</p>
        </div>

        <!-- Error Message -->
        {{#if error}}
        <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded">
            <p class="text-red-800 font-medium">{{error}}</p>
        </div>
        {{/if}}

        <!-- Success Message -->
        {{#if success}}
        <div class="mb-6 bg-green-50 border-l-4 border-green-500 p-4 rounded">
            <p class="text-green-800 font-medium">✓ {{success}}</p>
        </div>
        {{/if}}

        <!-- Settings Form -->
        <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-8">
            <form method="POST" action="/admin/landing" enctype="multipart/form-data" class="space-y-8">
                <!-- Hero Banner Section -->
                <div class="border-b border-gray-200 pb-8">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">Hero Banner</h2>
                    
                    <!-- Current Hero Banner -->
                    {{#if settings.hero_banner_image}}
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Current Hero Banner</label>
                        <div class="relative inline-block">
                            <img src="/uploads/{{settings.hero_banner_image}}" 
                                 alt="Hero Banner" 
                                 class="max-w-full h-auto max-h-64 rounded-lg border border-gray-300">
                        </div>
                    </div>
                    {{/if}}

                    <!-- Upload New Hero Banner -->
                    <div class="mb-6">
                        <label for="heroBanner" class="block text-sm font-semibold text-gray-700 mb-2">
                            {{#if settings.hero_banner_image}}Replace Hero Banner Image{{else}}Upload Hero Banner Image{{/if}}
                        </label>
                        <input type="file" 
                               id="heroBanner" 
                               name="heroBanner" 
                               accept="image/*"
                               class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                        <p class="text-xs text-gray-500 mt-2">Recommended size: 1920x600px or similar wide format. Max file size: 5MB</p>
                    </div>

                    <!-- Hero Banner Link -->
                    <div>
                        <label for="heroBannerLink" class="block text-sm font-semibold text-gray-700 mb-2">
                            Hero Banner Link (Optional)
                        </label>
                        <input type="url" 
                               id="heroBannerLink" 
                               name="heroBannerLink" 
                               value="{{settings.hero_banner_link}}"
                               placeholder="https://example.com"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition">
                        <p class="text-xs text-gray-500 mt-2">If provided, the hero banner image will be clickable and link to this URL</p>
                    </div>
                </div>

                <!-- Event Dates Section -->
                <div class="border-b border-gray-200 pb-8">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">Event Dates</h2>
                    <div>
                        <label for="eventDatesText" class="block text-sm font-semibold text-gray-700 mb-2">
                            Event Dates Display Text
                        </label>
                        <input type="text" 
                               id="eventDatesText" 
                               name="eventDatesText" 
                               value="{{settings.event_dates_text}}"
                               placeholder="e.g., March 15-17, 2024 or Coming Soon!"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition">
                        <p class="text-xs text-gray-500 mt-2">Custom text to display for event dates. If left empty, will use start/end dates from Event Settings.</p>
                    </div>
                </div>

                <!-- About this event -->
                <div>
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">About this event</h2>
                    <div id="aboutDrop" class="rounded-lg border border-dashed border-gray-300 p-4 transition">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-3">
                            <label for="landingPageContent" class="block text-sm font-semibold text-gray-700">
                                Markdown
                            </label>
                            <label class="inline-flex items-center px-3 py-2 text-sm font-semibold text-gray-700 border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50">
                                Choose a markdown file
                                <input id="aboutFile" type="file" accept=".md,.markdown,text/markdown,text/plain" class="sr-only">
                            </label>
                        </div>
                        <p id="aboutError" class="hidden mb-3 text-sm text-red-700" role="alert"></p>
                        <textarea id="landingPageContent"
                                  name="landingPageContent"
                                  rows="12"
                                  placeholder="Drop a .md file here, or write markdown. This is the description visitors read below the banner."
                                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent transition font-mono text-sm">{{settings.landing_page_content}}</textarea>
                        <p class="text-xs text-gray-500 mt-2">Drop a .md or .markdown file onto this box to replace the description. Files over 100KB are ignored.</p>
                    </div>
                    <div class="mt-6">
                        <h3 class="text-sm font-semibold text-gray-700 mb-2">How visitors will see it</h3>
                        <div id="aboutPreview" class="prose max-w-none rounded-lg border border-gray-200 bg-gray-50 p-6 min-h-[8rem]"></div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="flex items-center justify-end gap-4 pt-6 border-t border-gray-200">
                    <a href="/admin" 
                       class="px-6 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition">
                        Cancel
                    </a>
                    <button type="submit"
                            class="px-6 py-2 text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 rounded-lg transition">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>

        <!-- Preview Section -->
        <div class="mt-8 bg-white border border-gray-200 rounded-lg shadow-sm p-8">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Preview</h2>
            <p class="text-sm text-gray-600 mb-4">This is how your landing page will appear to visitors:</p>
            <div class="border border-gray-300 rounded-lg overflow-hidden">
                <iframe src="/" 
                        class="w-full h-[600px] border-0"
                        title="Landing Page Preview"></iframe>
            </div>
            <p class="text-xs text-gray-500 mt-2">Note: Preview may not reflect all changes until saved</p>
        </div>
    </div>
</div>

{{> prose-styles}}
<script src="https://cdn.jsdelivr.net/npm/marked@17.0.0/lib/marked.umd.js"></script>
<script>
    (function () {
        var MAX_BYTES = 100 * 1024;
        var textarea = document.getElementById('landingPageContent');
        var preview = document.getElementById('aboutPreview');
        var errorEl = document.getElementById('aboutError');
        var drop = document.getElementById('aboutDrop');
        var fileInput = document.getElementById('aboutFile');
        if (!textarea || !preview || !drop || !fileInput) return;

        var showError = function (message) {
            errorEl.textContent = message;
            errorEl.classList.remove('hidden');
        };

        var clearError = function () {
            errorEl.textContent = '';
            errorEl.classList.add('hidden');
        };

        var renderPreview = function () {
            var source = textarea.value || '';
            if (!source.trim()) {
                preview.innerHTML = '<p class="text-gray-400">Nothing to preview yet.</p>';
                return;
            }
            var parser = window.marked && (window.marked.parse || window.marked.marked);
            if (typeof parser !== 'function') {
                preview.textContent = source;
                return;
            }
            preview.innerHTML = parser(source, { breaks: true, gfm: true });
        };

        var isMarkdownFile = function (file) {
            var name = String(file && file.name || '').toLowerCase();
            return name.endsWith('.md') || name.endsWith('.markdown');
        };

        var applyFile = function (file) {
            clearError();
            if (!file) return;
            if (!isMarkdownFile(file)) {
                showError('Drop a .md or .markdown file.');
                return;
            }
            if (file.size > MAX_BYTES) {
                showError('That file is larger than 100KB.');
                return;
            }
            if (textarea.value.trim() && !window.confirm('Replace the current about text with this file?')) {
                return;
            }
            var reader = new FileReader();
            reader.onload = function () {
                textarea.value = typeof reader.result === 'string' ? reader.result : '';
                renderPreview();
            };
            reader.onerror = function () {
                showError('Could not read that file.');
            };
            reader.readAsText(file);
        };

        textarea.addEventListener('input', renderPreview);
        fileInput.addEventListener('change', function () {
            applyFile(fileInput.files && fileInput.files[0]);
            fileInput.value = '';
        });

        ['dragenter', 'dragover'].forEach(function (eventName) {
            drop.addEventListener(eventName, function (event) {
                event.preventDefault();
                drop.classList.add('ring-2', 'ring-gray-900', 'bg-gray-50');
            });
        });
        ['dragleave', 'drop'].forEach(function (eventName) {
            drop.addEventListener(eventName, function (event) {
                event.preventDefault();
                if (eventName === 'dragleave' && drop.contains(event.relatedTarget)) return;
                drop.classList.remove('ring-2', 'ring-gray-900', 'bg-gray-50');
            });
        });
        drop.addEventListener('drop', function (event) {
            var files = event.dataTransfer && event.dataTransfer.files;
            applyFile(files && files[0]);
        });

        renderPreview();
    })();
</script>

