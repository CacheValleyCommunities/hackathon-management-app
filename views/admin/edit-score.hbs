<div class="min-h-screen bg-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="mb-8">
            <a href="/admin/scores" class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-900 transition">
                ← Back to Scores
            </a>
        </div>

        <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Edit Score</h1>
        <p class="text-gray-600 mb-8">This updates the score stored for {{score.judge_email}}. It does not change who is assigned.</p>

        {{#if (lookup query 'error')}}
        <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
            <p class="text-red-800">{{lookup query 'error'}}</p>
        </div>
        {{/if}}

        <div class="border border-gray-200 rounded-lg p-6 mb-8">
            <div class="grid grid-cols-2 gap-6">
                <div>
                    <div class="text-xs text-gray-500 uppercase tracking-wide mb-2">Team</div>
                    <div class="text-lg font-semibold text-gray-900">{{score.team_name}}</div>
                </div>
                <div>
                    <div class="text-xs text-gray-500 uppercase tracking-wide mb-2">Table</div>
                    <div class="text-lg font-semibold text-gray-900">{{score.table_name}}</div>
                </div>
                <div>
                    <div class="text-xs text-gray-500 uppercase tracking-wide mb-2">Judge</div>
                    <div class="text-lg font-semibold text-gray-900">{{score.judge_email}}</div>
                </div>
                <div>
                    <div class="text-xs text-gray-500 uppercase tracking-wide mb-2">Round</div>
                    <div class="text-lg font-semibold text-gray-900">{{score.round}}</div>
                </div>
            </div>
        </div>

        <form method="POST" action="/admin/scores/{{score.id}}/update" class="space-y-8">
            {{> rubric-fields}}
            <div>
                <label for="notes" class="block text-sm font-semibold text-gray-700 mb-3">Notes</label>
                <textarea id="notes" name="notes" rows="6"
                    class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent resize-none">{{score.notes}}</textarea>
            </div>
            <button type="submit"
                class="w-full px-6 py-4 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-semibold text-lg transition">
                Save Score
            </button>
        </form>
    </div>
</div>
{{> rubric-input-script}}
