<div class="min-h-screen bg-white pb-24 lg:pb-8">
    <!-- Header -->
    <div class="bg-white border-b border-gray-200 sticky top-0 z-10 backdrop-blur-sm bg-white/95">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight">Judge Queue</h1>
                    <p class="text-sm text-gray-500 mt-2">Round {{round}} • Find your next team to judge</p>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                    <button id="open-table-map" type="button"
                        class="min-h-[48px] w-full sm:w-auto px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 border border-gray-300 rounded-lg transition hover:bg-gray-50">
                        View Table Map
                    </button>
                    <a href="/" class="min-h-[48px] inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition">
                        ← Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Messages -->
        {{#if (eq (lookup query 'message') 'all_complete')}}
        <div class="mb-8 bg-green-50 border border-green-200 rounded-lg p-6">
            <div class="flex items-start gap-4">
                <svg class="w-6 h-6 text-green-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                    <h3 class="text-lg font-semibold text-green-900 mb-2">All Teams Judged!</h3>
                    <p class="text-green-800">Excellent work! Every team in Round {{round}} has received at least {{requiredJudgesPerTeam}}
                        judges. Thank you for your contribution!</p>
                </div>
            </div>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'message') 'no_more_for_you')}}
        <div class="mb-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
            <div class="flex items-start gap-4">
                <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                    <h3 class="text-lg font-semibold text-blue-900 mb-2">Great Job!</h3>
                    <p class="text-blue-800">You've judged all teams that are available to you. Some teams still need
                        additional judges, but you've already judged them in previous rounds.</p>
                </div>
            </div>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'assignment_failed')}}
        <div class="mb-8 bg-red-50 border border-red-200 rounded-lg p-4">
            <p class="text-red-800">Failed to assign team. Please try again.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'duplicate_assignment')}}
        <div class="mb-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <p class="text-yellow-800">That team was already assigned. Please click "Get Next Team" again.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'judging_locked')}}
        <div class="mb-8 bg-red-50 border border-red-200 rounded-lg p-6">
            <div class="flex items-start gap-4">
                <svg class="w-6 h-6 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <div>
                    <h3 class="text-lg font-semibold text-red-900 mb-2">Judging Has Been Locked</h3>
                    <p class="text-red-800">Judging has been finalized. No new scores can be entered at this time.</p>
                </div>
            </div>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'incomplete_assignment')}}
        <div class="mb-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <p class="text-yellow-800">Please complete your current assignments before selecting a new team.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'already_judged')}}
        <div class="mb-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <p class="text-yellow-800">You have already judged this team. Please select a different team.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'team_not_found')}}
        <div class="mb-8 bg-red-50 border border-red-200 rounded-lg p-4">
            <p class="text-red-800">Team not found. Please try again.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'team_complete')}}
        <div class="mb-8 bg-blue-50 border border-blue-200 rounded-lg p-4">
            <p class="text-blue-800">This team already has enough judges. Please select a different team.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'team_locked')}}
        <div class="mb-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <p class="text-yellow-800">This team is currently being judged by another judge. Please select a different team.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'team_absent')}}
        <div class="mb-8 bg-blue-50 border border-blue-200 rounded-lg p-4">
            <p class="text-blue-800">This team has been marked absent. Please select a different team.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'message') 'marked_absent')}}
        <div class="mb-8 bg-blue-50 border border-blue-200 rounded-lg p-4">
            <p class="text-blue-800">Team marked absent. You can get another team.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'message') 'team_skipped')}}
        <div class="mb-8 bg-blue-50 border border-blue-200 rounded-lg p-4">
            <p class="text-blue-800">Team skipped. You will not judge that team again this round.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'team_skipped')}}
        <div class="mb-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <p class="text-yellow-800">You skipped this team. Please select a different team.</p>
        </div>
        {{/if}}

        <div class="mb-8 grid grid-cols-2 gap-4">
            <div class="border border-gray-200 rounded-lg p-6">
                <p class="text-sm text-gray-500">You've judged</p>
                <p class="text-3xl font-bold text-gray-900 mt-1">{{judgedThisRound}}</p>
                <p class="text-sm text-gray-600 mt-1">this round</p>
            </div>
            <div class="border border-gray-200 rounded-lg p-6">
                <p class="text-sm text-gray-500">Still need judges</p>
                <p class="text-3xl font-bold text-gray-900 mt-1">{{teamsNeedingJudges}}</p>
                <p class="text-sm text-gray-600 mt-1">teams this round</p>
            </div>
        </div>

        <!-- My Current Assignments -->
        {{#if currentAssignments.length}}
        <div class="mb-12 pb-8 border-b border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">My Current Assignments</h2>
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 mb-6">
                <div class="flex items-start gap-4">
                    <svg class="w-6 h-6 text-yellow-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <div class="flex-1">
                        <h3 class="text-lg font-semibold text-yellow-900 mb-2">You have incomplete assignments</h3>
                        <p class="text-yellow-800 mb-4">Please complete your current assignments before requesting new teams.</p>
                        <div class="space-y-3">
                            {{#each currentAssignments}}
                            <div class="bg-white rounded-lg p-4 border border-yellow-300">
                                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                                    <div>
                                        <div class="font-semibold text-gray-900">{{this.team_name}}</div>
                                        <div class="text-sm text-gray-600">Table {{this.table_name}} 
                                            {{#if this.division}}• {{this.division}}{{/if}}
                                        </div>
                                        <div class="text-xs text-gray-500 mt-1">Assigned: {{this.locked_at}}</div>
                                    </div>
                                    <div class="flex flex-col gap-3 w-full sm:w-auto sm:items-end">
                                        <a href="/scores/enter/{{encodeURIComponent this.team_name}}?round={{this.round}}"
                                            class="inline-flex items-center justify-center gap-2 min-h-[48px] w-full sm:w-auto px-4 py-2 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-medium text-sm transition">
                                            Continue Judging
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M13 7l5 5m0 0l-5 5m5-5H6" />
                                            </svg>
                                        </a>
                                        <form method="POST" action="/scores/skip" class="w-full sm:w-auto">
                                            <input type="hidden" name="teamName" value="{{this.team_name}}">
                                            <input type="hidden" name="round" value="{{this.round}}">
                                            <p class="text-xs text-gray-600 mb-2 sm:text-right">You will not judge this team again this round.</p>
                                            <button type="submit"
                                                class="min-h-[48px] w-full sm:w-auto px-4 py-2 border border-gray-300 text-gray-800 hover:bg-gray-50 rounded-lg font-medium text-sm transition">
                                                Skip this team
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/if}}

        <!-- Next Team Button -->
        <div class="mb-12 pb-8 border-b border-gray-200">
            <div class="text-center">
                {{#if judgingLocked}}
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg max-w-2xl mx-auto">
                    <p class="text-red-800 font-medium">Judging has been locked. No new scores can be entered.</p>
                </div>
                {{else}}
                <p class="text-gray-600 mb-6 max-w-2xl mx-auto">
                    Our intelligent system will assign you to the next team that needs judging.
                    You'll never be assigned to a team you've already judged.
                </p>
                <a href="/scores/next-team"
                    class="inline-flex items-center justify-center gap-3 min-h-[48px] w-full sm:w-auto px-8 py-4 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-semibold text-lg transition {{#if currentAssignments.length}}opacity-50 cursor-not-allowed{{/if}}"
                    {{#if currentAssignments.length}}onclick="return false;" title="Please complete your current assignments first"{{/if}}>
                    Get Next Team
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                </a>
                <p class="text-sm text-gray-500 mt-4">or <a href="/scores/select-team?round={{round}}"
                        class="text-gray-900 hover:underline font-medium">edit scores you already entered</a></p>
                {{/if}}
            </div>
        </div>

        <!-- Queue Status -->
        <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Queue Status</h2>
            <p class="text-sm text-gray-600 mb-4">Tap a team to assign yourself to judge it (if available).</p>
            <div class="sm:hidden space-y-3">
                {{#each queueStats}}
                <div class="rounded-lg border border-gray-200 p-4 {{#if this.canSelfAssign}}bg-white{{else}}bg-gray-50{{/if}}">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <p class="text-lg font-semibold {{#if this.canSelfAssign}}text-gray-900{{else}}text-gray-500{{/if}}">{{this.team_name}}</p>
                            <p class="text-sm text-gray-600 mt-1">Table {{this.table_name}}{{#if this.division}} · {{this.division}}{{/if}}</p>
                        </div>
                        <span class="inline-flex items-center justify-center min-w-[2rem] h-8 px-2 rounded-full text-sm font-semibold
                            {{#if (eq this.judge_count 0)}}bg-red-100 text-red-800
                            {{else if (lt this.judge_count ../requiredJudgesPerTeam)}}bg-orange-100 text-orange-800
                            {{else}}bg-green-100 text-green-800{{/if}}">
                            {{this.judge_count}}
                        </span>
                    </div>
                    <p class="text-sm font-medium mt-3">
                        {{#if this.isAbsent}}Absent
                        {{else if (eq this.judge_count 0)}}Needs judges
                        {{else if (lt this.judge_count ../requiredJudgesPerTeam)}}Needs {{subtract ../requiredJudgesPerTeam this.judge_count}} more
                        {{else}}Complete{{/if}}
                    </p>
                    {{#if this.canSelfAssign}}
                    <a href="/scores/assign-team/{{encodeURIComponent this.team_name}}"
                        class="mt-4 flex items-center justify-center min-h-[48px] w-full rounded-lg bg-gray-900 text-white font-semibold">
                        Judge this team
                    </a>
                    {{/if}}
                </div>
                {{/each}}
            </div>
            <div class="hidden sm:block border border-gray-200 rounded-lg overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th
                                    class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                    Team</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                    Table</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                    Division</th>
                                <th
                                    class="px-6 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                    Judges</th>
                                <th
                                    class="px-6 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                    Status</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {{#each queueStats}}
                            <tr 
                                class="transition {{#if this.canSelfAssign}}cursor-pointer hover:bg-blue-50 hover:border-blue-200{{else}}hover:bg-gray-50{{/if}}"
                                {{#if this.canSelfAssign}}
                                onclick="window.location.href='/scores/assign-team/{{encodeURIComponent this.team_name}}'"
                                {{/if}}
                            >
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        <div class="font-semibold {{#if this.canSelfAssign}}text-gray-900{{else}}text-gray-500{{/if}}">{{this.team_name}}</div>
                                        {{#if this.canSelfAssign}}
                                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                        </svg>
                                        <span class="text-xs text-blue-600 font-medium">Click to assign</span>
                                        {{/if}}
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm {{#if this.canSelfAssign}}text-gray-900{{else}}text-gray-500{{/if}}">{{this.table_name}}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm {{#if this.canSelfAssign}}text-gray-900{{else}}text-gray-500{{/if}}">
                                    {{#if this.division}}{{this.division}}{{else}}<span
                                        class="text-gray-400">—</span>{{/if}}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="inline-flex items-center justify-center w-8 h-8 rounded-full text-sm font-semibold
                                        {{#if (eq this.judge_count 0)}}bg-red-100 text-red-800
                                        {{else if (lt this.judge_count ../requiredJudgesPerTeam)}}bg-orange-100 text-orange-800
                                        {{else}}bg-green-100 text-green-800{{/if}}">
                                        {{this.judge_count}}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    {{#if this.isAbsent}}
                                    <span
                                        class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-200 text-gray-800">Absent</span>
                                    {{else if (eq this.judge_count 0)}}
                                    <span
                                        class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">Needs
                                        Judges</span>
                                    {{else if (lt this.judge_count ../requiredJudgesPerTeam)}}
                                    <span
                                        class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-orange-100 text-orange-800">Needs
                                        {{subtract ../requiredJudgesPerTeam this.judge_count}} More</span>
                                    {{else}}
                                    <span
                                        class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">✓
                                        Complete</span>
                                    {{/if}}
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- My Judging History -->
        {{#if judgedTeams.length}}
        <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-6">My Judging History</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {{#each judgedTeams}}
                <div class="border border-gray-200 rounded-lg p-4 hover:border-gray-300 hover:shadow-sm transition">
                    <div class="font-semibold text-gray-900 mb-1">{{this.team_name}}</div>
                    <div class="text-sm text-gray-500">Table {{this.table_name}} • Round {{this.round}}</div>
                    {{#if this.division}}
                    <div class="text-xs text-gray-400 mt-1">{{this.division}}</div>
                    {{/if}}
                </div>
                {{/each}}
            </div>
        </div>
        {{/if}}
    </div>

    <!-- Table Map Modal -->
    <div id="table-map-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-stretch sm:items-center justify-center sm:p-4"
        onclick="if(event.target === this) closeTableMap()">
        <div class="bg-white w-full h-full sm:h-auto sm:rounded-lg sm:max-w-6xl sm:max-h-[90vh] overflow-y-auto"
            onclick="event.stopPropagation()">
            <div class="sticky top-0 bg-white border-b border-gray-200 px-4 sm:px-6 py-4 flex items-center justify-between z-10">
                <h2 class="text-2xl font-bold text-gray-900">Event Floor Map</h2>
                <button type="button" onclick="closeTableMap()"
                    class="min-h-[48px] min-w-[48px] inline-flex items-center justify-center text-gray-700 hover:text-gray-900 transition" aria-label="Close map">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="p-4 sm:p-6 overflow-x-auto" id="table-map-content">
                <div class="text-center text-gray-500">Loading table map...</div>
            </div>
        </div>
    </div>

    <script>
        function closeTableMap() {
            document.getElementById('table-map-modal').classList.add('hidden');
            if (location.hash === '#map') {
                history.replaceState(null, '', location.pathname + location.search);
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const modal = document.getElementById('table-map-modal');
            const content = document.getElementById('table-map-content');
            let loaded = false;

            function loadTableMap() {
                if (loaded) return;
                fetch('/scores/table-map')
                    .then(response => response.text())
                    .then(html => {
                        content.innerHTML = html;
                        loaded = true;
                    })
                    .catch(function () {
                        content.innerHTML = '<div class="text-center text-red-500 p-4">Error loading table map. Please try again.</div>';
                    });
            }

            function openTableMap() {
                modal.classList.remove('hidden');
                loadTableMap();
            }

            const openButton = document.getElementById('open-table-map');
            if (openButton) {
                openButton.addEventListener('click', openTableMap);
            }

            if (location.hash === '#map') {
                openTableMap();
            }

            window.addEventListener('hashchange', function () {
                if (location.hash === '#map') openTableMap();
            });
        });
    </script>
    {{> judge-bottom-nav active="queue"}}
</div>