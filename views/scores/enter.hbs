<div class="min-h-screen bg-white pb-24 lg:pb-8">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
        <div class="mb-8">
            <a href="{{#if (eq (lookup query 'auto') '1')}}/scores/judge-queue{{else}}/scores/select-team?round={{round}}{{/if}}" class="inline-flex items-center min-h-[48px] gap-2 text-sm text-gray-600 hover:text-gray-900 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                {{#if (eq (lookup query 'auto') '1')}}Back to Queue{{else}}Back to Teams{{/if}}
            </a>
        </div>

        <div class="mb-8">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between mb-4">
                <div>
                    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight mb-2">
                        {{#if isEdit}}Edit{{else}}Enter{{/if}} Score
                    </h1>
                    <p class="text-lg text-gray-600">{{teamName}}</p>
                </div>
                <div class="flex items-start gap-8">
                    {{#unless isEdit}}
                    <div id="judging-timer" class="text-left sm:text-right" data-seconds="{{judgingSeconds}}" data-team="{{teamName}}" data-round="{{round}}">
                        <div class="text-xs text-gray-500 mb-1">Time left</div>
                        <div id="judging-timer-clock" class="text-3xl font-bold text-gray-900 tabular-nums">{{judgingMinutes}}:00</div>
                    </div>
                    {{/unless}}
                    <div class="sm:text-right">
                        <div class="text-xs text-gray-500 mb-1">Round</div>
                        <div class="text-3xl font-bold text-gray-900">{{round}}</div>
                    </div>
                </div>
            </div>
        </div>

        {{#if (lookup query 'error')}}
        <div class="mb-8 bg-red-50 border border-red-200 rounded-lg p-4">
            <p class="text-red-800">{{lookup query 'error'}}</p>
        </div>
        {{/if}}

        {{#unless isEdit}}
        <div id="team-confirm" class="mb-8 border border-gray-200 rounded-lg p-6" {{#if (lookup query 'error')}}hidden{{/if}}>
            <h2 class="text-xl font-bold text-gray-900 mb-2">Confirm this team</h2>
            <p class="text-gray-600 mb-6">Check the team name and table before you start scoring.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
                <div>
                    <div class="text-xs text-gray-500 uppercase tracking-wide mb-2">Team</div>
                    <div class="text-lg font-semibold text-gray-900">{{teamName}}</div>
                </div>
                <div>
                    <div class="text-xs text-gray-500 uppercase tracking-wide mb-2">Table</div>
                    <div class="text-lg font-semibold text-gray-900">{{tableName}}</div>
                </div>
            </div>
            <button type="button" id="confirm-team-button"
                class="w-full min-h-[48px] px-6 py-4 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-semibold text-lg transition">
                I'm with this team
            </button>
            <form method="POST" action="/scores/mark-absent" class="mt-3">
                <input type="hidden" name="teamName" value="{{teamName}}">
                <input type="hidden" name="round" value="{{round}}">
                {{#if (eq (lookup query 'auto') '1')}}
                <input type="hidden" name="auto" value="1">
                {{/if}}
                <button type="submit"
                    class="w-full min-h-[48px] px-6 py-3 border border-gray-300 text-gray-800 hover:bg-gray-50 rounded-lg font-semibold transition">
                    Can't find this team
                </button>
            </form>
            <form method="POST" action="/scores/skip" class="mt-3">
                <input type="hidden" name="teamName" value="{{teamName}}">
                <input type="hidden" name="round" value="{{round}}">
                {{#if (eq (lookup query 'auto') '1')}}
                <input type="hidden" name="auto" value="1">
                {{/if}}
                <p class="text-sm text-gray-600 mb-3 text-center">You will not judge this team again this round.</p>
                <button type="submit"
                    class="w-full min-h-[48px] px-6 py-3 border border-gray-300 text-gray-800 hover:bg-gray-50 rounded-lg font-semibold transition">
                    Skip this team
                </button>
            </form>
        </div>
        {{/unless}}

        <form method="POST" action="/scores/submit" id="score-form" class="space-y-8" {{#unless (or isEdit (lookup query 'error'))}}hidden{{/unless}}>
            <input type="hidden" name="teamName" value="{{teamName}}">
            <input type="hidden" name="round" value="{{round}}">
            <input type="hidden" name="tableName" value="{{tableName}}">
            {{#if (eq (lookup query 'auto') '1')}}
            <input type="hidden" name="auto" value="1">
            {{/if}}

            <div class="border border-gray-200 rounded-lg p-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <div class="text-xs text-gray-500 uppercase tracking-wide mb-2">Team</div>
                        <div class="text-lg font-semibold text-gray-900">{{teamName}}</div>
                    </div>
                    <div>
                        <div class="text-xs text-gray-500 uppercase tracking-wide mb-2">Table</div>
                        <div class="text-lg font-semibold text-gray-900">{{tableName}}</div>
                    </div>
                </div>
            </div>

            {{> rubric-fields}}

            <div>
                <label for="notes" class="block text-sm font-semibold text-gray-700 mb-3">
                    Notes <span class="text-gray-500 font-normal">(optional)</span>
                </label>
                <textarea id="notes"
                          name="notes"
                          rows="6"
                          class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent resize-none"
                          placeholder="Add any feedback or comments...">{{#if existingScore}}{{existingScore.notes}}{{/if}}</textarea>
            </div>

            <button type="submit"
                    class="w-full min-h-[48px] px-6 py-4 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-semibold text-lg transition">
                {{#if isEdit}}Update Score{{else}}Submit Score{{/if}}
            </button>
        </form>
        {{#unless isEdit}}
        <form method="POST" action="/scores/mark-absent" id="absent-below-score" class="mt-3" {{#unless (lookup query 'error')}}hidden{{/unless}}>
            <input type="hidden" name="teamName" value="{{teamName}}">
            <input type="hidden" name="round" value="{{round}}">
            {{#if (eq (lookup query 'auto') '1')}}
            <input type="hidden" name="auto" value="1">
            {{/if}}
            <button type="submit"
                class="w-full min-h-[48px] px-6 py-3 border border-gray-300 text-gray-800 hover:bg-gray-50 rounded-lg font-semibold transition">
                Can't find this team
            </button>
        </form>
        <form method="POST" action="/scores/skip" id="skip-below-score" class="mt-3" {{#unless (lookup query 'error')}}hidden{{/unless}}>
            <input type="hidden" name="teamName" value="{{teamName}}">
            <input type="hidden" name="round" value="{{round}}">
            {{#if (eq (lookup query 'auto') '1')}}
            <input type="hidden" name="auto" value="1">
            {{/if}}
            <p class="text-sm text-gray-600 mb-3 text-center">You will not judge this team again this round.</p>
            <button type="submit"
                class="w-full min-h-[48px] px-6 py-3 border border-gray-300 text-gray-800 hover:bg-gray-50 rounded-lg font-semibold transition">
                Skip this team
            </button>
        </form>
        {{/unless}}
    </div>
    {{> judge-bottom-nav}}
</div>

{{> rubric-input-script}}
