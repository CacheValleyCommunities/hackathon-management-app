<div id="judge-mobile" class="lg:hidden bg-white text-gray-900" style="padding-bottom: calc(7.5rem + env(safe-area-inset-bottom));">
    <div class="sticky top-0 z-30 bg-white border-b-2 border-black px-4 pt-4 pb-3">
        <div class="flex items-end justify-between gap-4">
            <div>
                <p class="text-lg font-semibold">Round {{round}}</p>
                <h1 id="judge-mobile-title" class="text-4xl font-bold leading-none mt-1">Queue</h1>
            </div>
            <a href="/" class="inline-flex items-center justify-center min-h-[52px] px-2 text-xl font-bold underline">Home</a>
        </div>
    </div>

    <section data-panel="queue" class="px-4 py-6">
        <p class="text-xl leading-snug mb-6">Tap the black button. We will send you to a team.</p>

        {{#if (eq (lookup query 'message') 'all_complete')}}
        <div class="mb-6 rounded-2xl bg-green-100 border-2 border-green-800 p-5">
            <p class="text-2xl font-bold text-green-950">All teams are done</p>
            <p class="text-xl text-green-950 mt-2">Every team in this round has enough judges. Thank you.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'message') 'no_more_for_you')}}
        <div class="mb-6 rounded-2xl bg-blue-100 border-2 border-blue-800 p-5">
            <p class="text-2xl font-bold text-blue-950">You are finished</p>
            <p class="text-xl text-blue-950 mt-2">You have scored every team that is still open to you.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'message') 'marked_absent')}}
        <div class="mb-6 rounded-2xl bg-blue-100 border-2 border-blue-800 p-5">
            <p class="text-xl text-blue-950">That team was marked absent. You can get another team.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'assignment_failed')}}
        <div class="mb-6 rounded-2xl bg-red-100 border-2 border-red-800 p-5">
            <p class="text-xl text-red-950">That did not work. Tap the button and try again.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'duplicate_assignment')}}
        <div class="mb-6 rounded-2xl bg-yellow-100 border-2 border-yellow-800 p-5">
            <p class="text-xl text-yellow-950">That team was already taken. Tap the button again.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'judging_locked')}}
        <div class="mb-6 rounded-2xl bg-red-100 border-2 border-red-800 p-5">
            <p class="text-2xl font-bold text-red-950">Judging is closed</p>
            <p class="text-xl text-red-950 mt-2">No new scores can be entered.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'incomplete_assignment')}}
        <div class="mb-6 rounded-2xl bg-yellow-100 border-2 border-yellow-800 p-5">
            <p class="text-xl text-yellow-950">Finish the team you already have before you pick another.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'already_judged')}}
        <div class="mb-6 rounded-2xl bg-yellow-100 border-2 border-yellow-800 p-5">
            <p class="text-xl text-yellow-950">You already scored that team. Pick a different one.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'team_not_found')}}
        <div class="mb-6 rounded-2xl bg-red-100 border-2 border-red-800 p-5">
            <p class="text-xl text-red-950">We could not find that team. Try again.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'team_complete')}}
        <div class="mb-6 rounded-2xl bg-blue-100 border-2 border-blue-800 p-5">
            <p class="text-xl text-blue-950">That team already has enough judges. Pick a different one.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'team_locked')}}
        <div class="mb-6 rounded-2xl bg-yellow-100 border-2 border-yellow-800 p-5">
            <p class="text-xl text-yellow-950">Another judge is with that team. Pick a different one.</p>
        </div>
        {{/if}}
        {{#if (eq (lookup query 'error') 'team_absent')}}
        <div class="mb-6 rounded-2xl bg-blue-100 border-2 border-blue-800 p-5">
            <p class="text-xl text-blue-950">That team is absent. Pick a different one.</p>
        </div>
        {{/if}}

        {{#if currentAssignments.length}}
            {{#each currentAssignments}}
            <a href="/scores/enter/{{encodeURIComponent this.team_name}}?round={{this.round}}"
                class="block w-full rounded-2xl bg-gray-900 text-white text-center px-6 py-8 mb-4">
                <span class="block text-xl font-semibold">Go to this team</span>
                <span class="block text-4xl font-bold mt-3 leading-tight">{{this.team_name}}</span>
                <span class="block text-2xl mt-3">Table {{this.table_name}}</span>
            </a>
            {{/each}}
            <p class="text-xl">Finish this team before you get another one.</p>
        {{else if judgingLocked}}
            <div class="rounded-2xl bg-red-100 border-2 border-red-800 p-5">
                <p class="text-2xl font-bold text-red-950">Judging is closed</p>
                <p class="text-xl text-red-950 mt-2">You cannot enter new scores.</p>
            </div>
        {{else}}
            <a href="/scores/next-team"
                class="flex items-center justify-center w-full min-h-[96px] rounded-2xl bg-gray-900 text-white text-3xl font-bold px-6 text-center">
                Get my next team
            </a>
        {{/if}}

        <p class="text-xl mt-8">{{teamsNeedingJudges}} teams still need a judge.</p>
        <p class="text-xl mt-1">You have scored {{myTeamCount}} {{#if (eq myTeamCount 1)}}team{{else}}teams{{/if}}.</p>

        {{#if teamsYouCanPick.length}}
        <h2 class="text-3xl font-bold mt-10 mb-4">Or pick a team</h2>
        <div class="space-y-4">
            {{#each teamsYouCanPick}}
            <a href="/scores/assign-team/{{encodeURIComponent this.team_name}}"
                class="block rounded-2xl border-2 border-gray-900 p-5">
                <span class="block text-3xl font-bold leading-tight">{{this.team_name}}</span>
                <span class="block text-2xl mt-2">Table {{this.table_name}}</span>
                {{#if this.division}}
                <span class="block text-xl mt-1">{{this.division}}</span>
                {{/if}}
                <span class="block text-xl font-bold underline mt-4">Judge this team</span>
            </a>
            {{/each}}
        </div>
        {{/if}}

        {{#if queueStats.length}}
        <button type="button" id="show-all-teams"
            class="mt-8 w-full min-h-[64px] rounded-2xl border-2 border-gray-900 text-xl font-bold">
            Show every team
        </button>
        <div id="all-teams" class="mt-4 space-y-3" hidden>
            {{#each queueStats}}
            <div class="rounded-2xl border-2 border-gray-300 p-5">
                <p class="text-2xl font-bold leading-tight">{{this.team_name}}</p>
                <p class="text-xl mt-1">Table {{this.table_name}}{{#if this.division}} · {{this.division}}{{/if}}</p>
                <p class="text-xl font-semibold mt-3">
                    {{#if this.isAbsent}}
                    Absent
                    {{else if (eq this.judge_count 0)}}
                    Needs a judge
                    {{else if (lt this.judge_count ../requiredJudgesPerTeam)}}
                    Needs {{subtract ../requiredJudgesPerTeam this.judge_count}} more
                    {{else}}
                    Finished
                    {{/if}}
                </p>
            </div>
            {{/each}}
        </div>
        {{/if}}
    </section>

    <section data-panel="map" class="px-4 py-6" hidden>
        <p id="map-hint" class="text-xl leading-snug mb-6">Dark squares have a team. Slide the map sideways to see more.</p>

        <label for="map-search" class="block text-2xl font-bold mb-3">Find a table or team</label>
        <input id="map-search" type="search" enterkeyhint="search" autocomplete="off"
            placeholder="Try A1 or a team name"
            class="w-full min-h-[64px] px-4 text-2xl border-2 border-gray-900 rounded-2xl">

        <p id="map-no-match" class="text-xl mt-6" hidden>Nothing matches that. Try a table like A1.</p>

        <div id="map-results" class="mt-4 space-y-3">
            {{#each mapTables}}
            <article data-map-card="{{this.searchText}}" class="rounded-2xl border-2 border-gray-900 p-5" hidden>
                <p class="text-5xl font-bold leading-none">{{this.id}}</p>
                {{#each this.teams}}
                <p class="text-2xl mt-3">{{this.name}}</p>
                {{#if this.division}}
                <p class="text-xl">{{this.division}}</p>
                {{/if}}
                {{/each}}
            </article>
            {{/each}}
        </div>

        <div id="floor-map" class="mt-8">
            {{#if gridRows.length}}
            {{#if assignmentTables.length}}
            <p class="text-xl font-semibold mb-4">Your team is the yellow square.</p>
            {{/if}}
            <div class="overflow-x-auto pb-2 -mx-4 px-4">
                <table class="border-separate" style="border-spacing: 6px;">
                    <tbody>
                        {{#each gridRows}}
                        <tr>
                            {{#each this}}
                            <td class="text-center font-bold rounded-xl border-2 border-gray-900
                                {{#if (contains ../../assignmentTables id)}}bg-yellow-300 text-black
                                {{else if (gt teams.length 0)}}bg-gray-900 text-white
                                {{else}}bg-white text-gray-800{{/if}}"
                                style="width: 84px; height: 84px; min-width: 84px; font-size: 22px;">
                                {{id}}
                            </td>
                            {{/each}}
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            <div class="bg-gray-900 text-white font-bold text-center py-5 rounded-2xl mt-4 text-3xl">
                STAGE
            </div>
            <div class="mt-6 space-y-3 text-xl">
                <p class="flex items-center gap-3"><span class="inline-block w-8 h-8 bg-gray-900 border-2 border-gray-900 rounded-md"></span> Has a team</p>
                <p class="flex items-center gap-3"><span class="inline-block w-8 h-8 bg-white border-2 border-gray-900 rounded-md"></span> Empty</p>
                {{#if assignmentTables.length}}
                <p class="flex items-center gap-3"><span class="inline-block w-8 h-8 bg-yellow-300 border-2 border-gray-900 rounded-md"></span> Your team</p>
                {{/if}}
            </div>
            {{else}}
            <p class="text-xl mt-6">No tables are set up yet.</p>
            {{/if}}
        </div>
    </section>

    <section data-panel="scores" class="px-4 py-6" hidden>
        <p class="text-xl leading-snug mb-6">These are the scores you already gave.</p>

        {{#if scores.length}}
            {{#each scoresByRound}}
            <h2 class="text-3xl font-bold mt-2 mb-4">Round {{@key}}</h2>
            <div class="space-y-4 mb-10">
                {{#each this}}
                <article class="rounded-2xl border-2 border-gray-900 p-5">
                    <p class="text-3xl font-bold leading-tight">{{this.team_name}}</p>
                    <p class="text-xl mt-2">Table {{this.table_name}}{{#if this.division}} · {{this.division}}{{/if}}</p>
                    <p class="text-6xl font-bold mt-4 leading-none">{{toFixed this.score 1}}</p>
                    {{#if this.notes}}
                    <p class="text-xl mt-4">{{this.notes}}</p>
                    {{/if}}
                    {{#unless (contains ../../lockedRounds this.round)}}
                    <a href="/scores/enter/{{encodeURIComponent this.team_name}}?round={{this.round}}"
                        class="mt-5 flex items-center justify-center w-full min-h-[64px] rounded-2xl border-2 border-gray-900 text-xl font-bold">
                        Change this score
                    </a>
                    {{else}}
                    <p class="text-xl font-semibold mt-5">This round is finished.</p>
                    {{/unless}}
                </article>
                {{/each}}
            </div>
            {{/each}}
        {{else}}
        <div class="rounded-2xl border-2 border-gray-900 p-6">
            <p class="text-2xl font-bold">No scores yet</p>
            <p class="text-xl mt-2">Go to Queue and get your first team.</p>
            <button type="button" data-goto="queue"
                class="mt-6 w-full min-h-[72px] rounded-2xl bg-gray-900 text-white text-2xl font-bold">
                Go to Queue
            </button>
        </div>
        {{/if}}
    </section>

    <nav class="fixed bottom-0 inset-x-0 z-40 bg-white border-t-2 border-black lg:hidden"
        style="padding-bottom: env(safe-area-inset-bottom);" aria-label="Judge sections">
        <div class="grid grid-cols-3" role="tablist">
            <button type="button" data-tab="queue" role="tab" aria-selected="true"
                class="judge-tab flex flex-col items-center justify-center gap-1 min-h-[80px] text-xl font-bold bg-gray-900 text-white">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h10" />
                </svg>
                Queue
            </button>
            <button type="button" data-tab="map" role="tab" aria-selected="false"
                class="judge-tab flex flex-col items-center justify-center gap-1 min-h-[80px] text-xl font-bold bg-white text-gray-900 border-l-2 border-black">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                </svg>
                Map
            </button>
            <button type="button" data-tab="scores" role="tab" aria-selected="false"
                class="judge-tab flex flex-col items-center justify-center gap-1 min-h-[80px] text-xl font-bold bg-white text-gray-900 border-l-2 border-black">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118L2.075 10.1c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                </svg>
                Scores
            </button>
        </div>
    </nav>
</div>

<script>
    (function () {
        var root = document.getElementById('judge-mobile');
        if (!root) return;

        var allowed = ['queue', 'map', 'scores'];
        var titles = { queue: 'Queue', map: 'Map', scores: 'Scores' };
        var panels = root.querySelectorAll('[data-panel]');
        var tabs = root.querySelectorAll('[data-tab]');
        var title = document.getElementById('judge-mobile-title');

        function apply(name) {
            if (allowed.indexOf(name) === -1) name = 'queue';
            panels.forEach(function (panel) {
                panel.hidden = panel.getAttribute('data-panel') !== name;
            });
            tabs.forEach(function (tab) {
                var on = tab.getAttribute('data-tab') === name;
                tab.setAttribute('aria-selected', on ? 'true' : 'false');
                tab.classList.toggle('bg-gray-900', on);
                tab.classList.toggle('text-white', on);
                tab.classList.toggle('bg-white', !on);
                tab.classList.toggle('text-gray-900', !on);
            });
            if (title) title.textContent = titles[name];
            window.scrollTo(0, 0);
        }

        function openTab(name) {
            if (allowed.indexOf(name) === -1) name = 'queue';
            var current = (location.hash || '').replace('#', '');
            if (current === name || (current === '' && name === 'queue')) {
                apply(name);
                return;
            }
            history.pushState({ judgeTab: name }, '', '#' + name);
            apply(name);
        }

        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                openTab(tab.getAttribute('data-tab'));
            });
        });

        root.querySelectorAll('[data-goto]').forEach(function (button) {
            button.addEventListener('click', function () {
                openTab(button.getAttribute('data-goto'));
            });
        });

        window.addEventListener('popstate', function () {
            var hash = (location.hash || '').replace('#', '');
            apply(allowed.indexOf(hash) === -1 ? 'queue' : hash);
        });

        var hash = (location.hash || '').replace('#', '');
        var params = new URLSearchParams(location.search);
        var fromQuery = params.get('tab');
        var start = allowed.indexOf(hash) !== -1 ? hash : (allowed.indexOf(fromQuery) !== -1 ? fromQuery : 'queue');
        if (start !== 'queue') {
            history.replaceState({ judgeTab: start }, '', '#' + start);
        }
        apply(start);

        var showAll = document.getElementById('show-all-teams');
        var allTeams = document.getElementById('all-teams');
        if (showAll && allTeams) {
            showAll.addEventListener('click', function () {
                var opening = allTeams.hidden;
                allTeams.hidden = !opening;
                showAll.textContent = opening ? 'Hide the full list' : 'Show every team';
            });
        }

        var mapSearch = document.getElementById('map-search');
        var mapGrid = document.getElementById('floor-map');
        var mapHint = document.getElementById('map-hint');
        var mapEmpty = document.getElementById('map-no-match');
        var mapCards = root.querySelectorAll('[data-map-card]');
        if (mapSearch) {
            mapSearch.addEventListener('input', function () {
                var query = mapSearch.value.trim().toLowerCase();
                var shown = 0;
                mapCards.forEach(function (card) {
                    var match = query !== '' && card.getAttribute('data-map-card').indexOf(query) !== -1;
                    card.hidden = !match;
                    if (match) shown += 1;
                });
                var searching = query !== '';
                if (mapGrid) mapGrid.hidden = searching;
                if (mapHint) mapHint.hidden = searching;
                if (mapEmpty) mapEmpty.hidden = !searching || shown > 0;
            });
        }
    })();
</script>
